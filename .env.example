# À renseigner dans Vercel → Projet ge-media → Settings → Environment Variables

# Sanity (identifiant visible sur sanity.io/manage après création du projet)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Brevo (Brevo → SMTP & API → Clés API ; ID de la liste dans Contacts → Listes)
BREVO_API_KEY=
BREVO_LIST_ID=

# Formulaire de contact
CONTACT_TO_EMAIL=contact@jauge.media
CONTACT_FROM_EMAIL=contact@jauge.media
