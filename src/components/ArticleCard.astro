---
import { categoryBySlug, subcategoryLabel } from '../config';
import { imageUrl, formatDate, type ArticleCard } from '../lib/sanity';

interface Props {
  article: ArticleCard;
  /** Ajoute data-category pour les filtres des pages catégorie */
  filterable?: boolean;
  class?: string;
}
const { article: a, filterable = false, class: extra = '' } = Astro.props;
const cat = categoryBySlug(a.category);
const img = imageUrl(a.mainImage, 600, 338);
const label = subcategoryLabel(a.category, a.subcategory) || cat?.short || '';
---
<a href={`/${a.category}/${a.slug}`} class={`article-card ${extra}`.trim()} data-category={filterable ? a.subcategory || 'autre' : undefined}>
  <article>
    {img && (
      <div class="article-card-img">
        <img src={img} alt={a.mainImage?.alt || ''} width="600" height="338" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="article-card-body" style={img ? undefined : 'padding:24px;'}>
      <div class="article-card-meta">
        {label && <span class={`tag ${cat?.tag ?? ''}`}>{label}</span>}
        <span class="sep" aria-hidden="true">·</span>
        <time datetime={a.publishedAt}>{formatDate(a.publishedAt)}</time>
      </div>
      <h3>{a.title}</h3>
      {a.excerpt && <p class="article-card-excerpt">{a.excerpt}</p>}
      <div class="article-card-footer"><span>Lire →</span>{a.readingTime && <span>{a.readingTime} min</span>}</div>
    </div>
  </article>
</a>
