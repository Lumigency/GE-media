---
// Bandeau de consentement (CNIL) : Google Analytics n'est chargé qu'après un « Accepter ».
// Refuser est aussi simple qu'accepter ; le choix est gardé 6 mois (refus) ou 13 mois (accord).
import { GA_ID } from '../config';
---
{GA_ID && (
  <>
    <div class="consent" id="consent" role="dialog" aria-modal="false" aria-labelledby="consent-title" hidden>
      <div class="consent-inner">
        <p class="consent-title" id="consent-title">On mesure l'audience, si vous êtes d'accord</p>
        <p class="consent-text">
          Avec votre accord, on utilise Google Analytics pour savoir quels articles sont lus et améliorer Jauge. Pas de pub, pas de revente.
          Vous pouvez changer d'avis à tout moment via « Gérer les cookies » en bas de page. <a href="/mentions-legales#cookies">En savoir plus</a>.
        </p>
        <div class="consent-actions">
          <button type="button" class="consent-btn" data-consent="denied">Refuser</button>
          <button type="button" class="consent-btn" data-consent="granted">Accepter</button>
        </div>
      </div>
    </div>
    <script is:inline define:vars={{ GA_ID }}>
      (function () {
        var KEY = 'jauge-consent';
        var MONTH = 30 * 24 * 3600 * 1000;
        var banner = document.getElementById('consent');
        function read() {
          try { var c = JSON.parse(localStorage.getItem(KEY) || 'null'); } catch (e) { return null; }
          if (!c || !c.v || !c.t) return null;
          var max = c.v === 'granted' ? 13 * MONTH : 6 * MONTH;
          return Date.now() - c.t < max ? c.v : null;
        }
        function save(v) { try { localStorage.setItem(KEY, JSON.stringify({ v: v, t: Date.now() })); } catch (e) {} }
        function loadGA() {
          if (window.__gaLoaded) return; window.__gaLoaded = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { dataLayer.push(arguments); };
          // Consent Mode v2 : mesure d'audience acceptée, aucune finalité publicitaire
          gtag('consent', 'default', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
          gtag('js', new Date());
          gtag('config', GA_ID);
          var s = document.createElement('script');
          s.async = true; s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
          document.head.appendChild(s);
          // Clics vers les outils (/go/…) : utile pour suivre l'affiliation
          document.addEventListener('click', function (e) {
            var a = e.target.closest && e.target.closest('a[href^="/go/"]');
            if (a) gtag('event', 'clic_outil', { outil: a.getAttribute('href').slice(4), page: location.pathname });
          });
        }
        function clearGA() {
          document.cookie.split(';').forEach(function (c) {
            var n = c.split('=')[0].trim();
            if (n.indexOf('_ga') === 0) {
              ['', '.' + location.hostname, '.' + location.hostname.replace(/^www\./, '')].forEach(function (d) {
                document.cookie = n + '=; Max-Age=0; path=/' + (d ? '; domain=' + d : '');
              });
            }
          });
        }
        function show() { banner.hidden = false; }
        banner.addEventListener('click', function (e) {
          var b = e.target.closest('[data-consent]'); if (!b) return;
          var v = b.getAttribute('data-consent'); var before = read();
          save(v); banner.hidden = true;
          if (v === 'granted') loadGA();
          else if (before === 'granted') { clearGA(); location.reload(); }
        });
        document.addEventListener('click', function (e) {
          if (e.target.closest && e.target.closest('[data-manage-consent]')) { e.preventDefault(); show(); }
        });
        var c = read();
        if (c === 'granted') loadGA(); else if (c === null) show();
      })();
    </script>
  </>
)}
