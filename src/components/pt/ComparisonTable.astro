---
const { node } = Astro.props;
---
<figure class="article-table">
  {node.caption && <figcaption class="article-table-caption">{node.caption}</figcaption>}
  <div class="comparison-table-wrap">
    <table class="comparison-table">
      <thead><tr>{(node.columns || []).map((c: string) => <th scope="col">{c}</th>)}</tr></thead>
      <tbody>
        {(node.rows || []).map((r: any) => (
          <tr>{(r.cells || []).map((cell: string, i: number) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
        ))}
      </tbody>
    </table>
  </div>
  {node.source && <p class="article-table-source">{node.source}</p>}
</figure>
