---
import { internalPath } from '../../lib/links';
const { node } = Astro.props;
const raw: string = node.markDef?.href || '#';
const internal = internalPath(raw);
const href = internal ?? raw;
const external = !internal && /^https?:\/\//.test(raw);
const affiliate = Boolean(node.markDef?.affiliate);
const rel = affiliate ? 'sponsored nofollow noopener' : external ? 'noopener' : undefined;
---
<a href={href} rel={rel} target={external ? '_blank' : undefined}><slot /></a>
