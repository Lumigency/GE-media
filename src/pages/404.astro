---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../config';
---
<Base title="Page introuvable | Jauge" description="Cette page n'existe pas ou plus." noindex>
  <main>
    <section class="page-hero">
      <div class="container">
        <p class="section-label" style="justify-content:center;">Erreur 404</p>
        <h1>Jauge à zéro : cette page n'existe pas</h1>
        <p>L'article a peut-être changé d'adresse. Repars d'une des 4 jauges :</p>
        <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:24px;">
          {CATEGORIES.map((c) => <a class="btn btn-outline" href={`/${c.slug}`}>{c.title}</a>)}
        </div>
        <p style="margin-top:24px;"><a href="/">← Retour à l'accueil</a></p>
      </div>
    </section>
  </main>
</Base>
