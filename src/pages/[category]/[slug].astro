---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { PortableText, toPlainText } from 'astro-portabletext';
import Heading from '../../components/pt/Heading.astro';
import Link from '../../components/pt/Link.astro';
import Figure from '../../components/pt/Figure.astro';
import Callout from '../../components/pt/Callout.astro';
import AffiliateBox from '../../components/pt/AffiliateBox.astro';
import ComparisonTable from '../../components/pt/ComparisonTable.astro';
import { getFullArticles, imageUrl, formatDate } from '../../lib/sanity';
import { categoryBySlug, subcategoryLabel, SITE } from '../../config';
import { slugify } from '../../lib/text';

export async function getStaticPaths() {
  const articles = await getFullArticles();
  return articles
    .filter((a) => categoryBySlug(a.category))
    .map((a) => ({ params: { category: a.category, slug: a.slug }, props: { article: a } }));
}

const { article: a } = Astro.props;
const cat = categoryBySlug(a.category)!;
const url = `${SITE.url}/${a.category}/${a.slug}`;
const body = a.body ?? [];
const toc = body
  .filter((b: any) => b._type === 'block' && b.style === 'h2')
  .map((b: any) => ({ text: toPlainText(b), id: slugify(toPlainText(b)) }));
const hasAffiliate =
  body.some((b: any) => b._type === 'affiliateBox') ||
  body.some((b: any) => (b.markDefs ?? []).some((m: any) => m._type === 'link' && m.affiliate));
const hero = imageUrl(a.mainImage, 1440, 810);
const ogImage = imageUrl(a.mainImage, 1200, 630) ?? SITE.ogImage;
const modified = a.updatedAt || a.publishedAt;
const author = a.author;
const authorPhoto = imageUrl(author?.photo, 160, 160);
const rubrique = subcategoryLabel(a.category, a.subcategory);

const authorLd = author
  ? {
      '@type': 'Person',
      name: author.name,
      jobTitle: author.role,
      description: author.bio,
      url: `${SITE.url}/a-propos#${author.slug}`,
      sameAs: [author.linkedin, author.website].filter(Boolean),
    }
  : { '@id': `${SITE.url}/#organization` };

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: a.title,
    description: a.seoDescription || a.excerpt,
    datePublished: a.publishedAt,
    dateModified: modified,
    inLanguage: SITE.lang,
    mainEntityOfPage: url,
    url,
    image: ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`,
    author: authorLd,
    publisher: { '@id': `${SITE.url}/#organization` },
    articleSection: cat.title,
    ...(a.keyTakeaways?.length ? { abstract: a.keyTakeaways.join(' ') } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.title, item: `${SITE.url}/${cat.slug}` },
      { '@type': 'ListItem', position: 3, name: a.title, item: url },
    ],
  },
];
if (a.faq?.length) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: a.faq.map((f: any) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}

const components = {
  type: { image: Figure, callout: Callout, affiliateBox: AffiliateBox, comparisonTable: ComparisonTable },
  block: { h2: Heading, h3: Heading },
  mark: { link: Link },
};
---
<Base
  title={`${a.seoTitle || a.title} | Jauge`}
  description={a.seoDescription || a.excerpt}
  image={ogImage}
  type="article"
  noindex={a.noindex}
  jsonLd={jsonLd}
  publishedTime={a.publishedAt}
  modifiedTime={modified}
  readingProgress
>
  <main>
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href={`/${cat.slug}`}>{cat.title}</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">{a.title}</span>
        </nav>
        {rubrique && <p class="section-label" style="justify-content:center;">{rubrique}</p>}
        <h1>{a.title}</h1>
        {a.excerpt && <p>{a.excerpt}</p>}
        <div class="article-card-meta" style="justify-content:center;flex-wrap:wrap;">
          {author && <span>Par <a href={`/a-propos#${author.slug}`}>{author.name}</a></span>}
          <span class="sep" aria-hidden="true">·</span>
          <time datetime={a.publishedAt}>Publié le {formatDate(a.publishedAt)}</time>
          {a.updatedAt && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <time datetime={a.updatedAt}>Mis à jour le {formatDate(a.updatedAt)}</time>
            </>
          )}
          {a.readingTime && (<><span class="sep" aria-hidden="true">·</span><span>{a.readingTime} min de lecture</span></>)}
        </div>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        {hero && (
          <img class="article-hero-img" src={hero} alt={a.mainImage?.alt || ''} width="1440" height="810" loading="eager" fetchpriority="high" style="width:100%;height:auto;margin-bottom:8px;" />
        )}
        {hero && a.heroCredit && <p style="font-size:.75rem;opacity:.6;margin:0 0 32px;text-align:right;">{a.heroCredit}</p>}
        {hero && !a.heroCredit && <div style="height:32px;"></div>}
        <article class="page-with-sidebar">
          {toc.length > 1 ? (
            <aside class="toc" aria-label="Sommaire">
              <p class="toc-title">Sommaire</p>
              <ol>{toc.map((t: any) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
            </aside>
          ) : <div></div>}

          <div class="article-content">
            {hasAffiliate && (
              <p class="affiliate-box" style="font-size:.85rem;">
                Transparence : cet article contient des liens affiliés. Si tu passes par eux, Jauge peut toucher une commission, sans surcoût pour toi et sans influence sur notre avis. <a href="/mentions-legales#affiliation">Notre politique</a>.
              </p>
            )}

            {a.keyTakeaways?.length > 0 && (
              <section class="affiliate-box" aria-labelledby="essentiel" style="margin-bottom:32px;">
                <h2 id="essentiel" style="margin-top:0;font-size:1.25rem;">L'essentiel</h2>
                <ul>{a.keyTakeaways.map((k: string) => <li>{k}</li>)}</ul>
              </section>
            )}

            <PortableText value={body} components={components} onMissingComponent={false} />

            {a.faq?.length > 0 && (
              <section aria-labelledby="faq">
                <h2 id="faq">Questions fréquentes</h2>
                {a.faq.map((f: any) => (
                  <>
                    <h3>{f.question}</h3>
                    <p>{f.answer}</p>
                  </>
                ))}
              </section>
            )}

            {author && (
              <aside class="affiliate-box" style="display:flex;gap:16px;align-items:flex-start;margin-top:48px;" aria-label="À propos de l'auteur">
                {authorPhoto && <img src={authorPhoto} alt={author.name} width="64" height="64" loading="lazy" style="border-radius:50%;flex-shrink:0;" />}
                <div>
                  <p style="margin:0 0 4px;"><strong>{author.name}</strong>{author.role && <> · {author.role}</>}</p>
                  {author.bio && <p style="margin:0;">{author.bio}</p>}
                  {author.linkedin && <p style="margin:6px 0 0;"><a href={author.linkedin} rel="noopener me" target="_blank">LinkedIn</a></p>}
                </div>
              </aside>
            )}
          </div>
        </article>

        {a.related?.length > 0 && (
          <section class="related-articles" aria-labelledby="related-title" style="margin-top:64px;">
            <h2 id="related-title">À lire aussi</h2>
            <div class="grid-3">{a.related.filter(Boolean).map((r: any) => <ArticleCard article={r} />)}</div>
          </section>
        )}
        <p style="margin-top:32px;"><a href={`/${cat.slug}`}>← Tous les articles {cat.title}</a></p>
      </div>
    </section>
  </main>
</Base>
