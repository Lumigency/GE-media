---
import Base from '../../layouts/Base.astro';
import '../../styles/article.css';
import ArticleCard from '../../components/ArticleCard.astro';
import { PortableText, toPlainText } from 'astro-portabletext';
import Heading from '../../components/pt/Heading.astro';
import Link from '../../components/pt/Link.astro';
import Figure from '../../components/pt/Figure.astro';
import Callout from '../../components/pt/Callout.astro';
import AffiliateBox from '../../components/pt/AffiliateBox.astro';
import ComparisonTable from '../../components/pt/ComparisonTable.astro';
import { getFullArticles, imageUrl, formatDate } from '../../lib/sanity';
import { categoryBySlug, subcategoryLabel, SITE } from '../../config';
import { slugify } from '../../lib/text';
import { internalPath } from '../../lib/links';

export async function getStaticPaths() {
  const articles = await getFullArticles();
  return articles
    .filter((a) => categoryBySlug(a.category))
    .map((a) => ({ params: { category: a.category, slug: a.slug }, props: { article: a } }));
}

const { article: a } = Astro.props;
const cat = categoryBySlug(a.category)!;
const url = `${SITE.url}/${a.category}/${a.slug}`;
const body = a.body ?? [];
const toc = body
  .filter((b: any) => b._type === 'block' && b.style === 'h2')
  .map((b: any) => ({ text: toPlainText(b), id: slugify(toPlainText(b)) }));
const hasAffiliate =
  body.some((b: any) => b._type === 'affiliateBox') ||
  body.some((b: any) => (b.markDefs ?? []).some((m: any) => m._type === 'link' && m.affiliate));
const hero = imageUrl(a.mainImage, 1440, 630);
const ogImage = imageUrl(a.mainImage, 1200, 630) ?? SITE.ogImage;
const modified = a.updatedAt || a.publishedAt;
const author = a.author;
const authorPhoto = imageUrl(author?.photo, 160, 160);
const hasToc = toc.length > 1;
const rubrique = subcategoryLabel(a.category, a.subcategory);

// Sources : liens externes non affiliés du corps + sources saisies à la main, sans doublon.
const normUrl = (u: string) => u.trim().replace(/#.*$/, '').replace(/\/$/, '');
const hostOf = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return ''; } };
const sourceMap = new Map<string, { title: string; url: string; host: string }>();
for (const b of body) {
  if (b?._type !== 'block') continue;
  for (const m of b.markDefs ?? []) {
    const href: string = m?.href ?? '';
    if (m?._type !== 'link' || m.affiliate || !/^https?:\/\//.test(href)) continue;
    if (internalPath(href) || /\/go\//.test(href)) continue;
    const key = normUrl(href);
    if (sourceMap.has(key)) continue;
    const text = (b.children ?? []).filter((c: any) => (c.marks ?? []).includes(m._key)).map((c: any) => c.text).join('').trim();
    sourceMap.set(key, { title: text || hostOf(href), url: href, host: hostOf(href) });
  }
}
for (const src of a.sources ?? []) {
  if (!src?.url || !src?.title) continue;
  const key = normUrl(src.url);
  sourceMap.set(key, { title: src.title, url: src.url, host: hostOf(src.url) });
}
const sources = [...sourceMap.values()];

const authorLd = author
  ? {
      '@type': 'Person',
      name: author.name,
      jobTitle: author.role,
      description: author.bio,
      url: `${SITE.url}/a-propos#${author.slug}`,
      sameAs: [author.linkedin, author.website].filter(Boolean),
    }
  : { '@id': `${SITE.url}/#organization` };

const jsonLd: Record<string, unknown>[] = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: a.title,
    description: a.seoDescription || a.excerpt,
    datePublished: a.publishedAt,
    dateModified: modified,
    inLanguage: SITE.lang,
    mainEntityOfPage: url,
    url,
    image: ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`,
    author: authorLd,
    publisher: { '@id': `${SITE.url}/#organization` },
    articleSection: cat.title,
    ...(a.keyTakeaways?.length ? { abstract: a.keyTakeaways.join(' ') } : {}),
    ...(sources.length ? { citation: sources.map((x) => ({ '@type': 'CreativeWork', name: x.title, url: x.url })) } : {}),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: cat.title, item: `${SITE.url}/${cat.slug}` },
      { '@type': 'ListItem', position: 3, name: a.title, item: url },
    ],
  },
];
if (a.faq?.length) {
  jsonLd.push({
    '@type': 'FAQPage',
    mainEntity: a.faq.map((f: any) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })),
  });
}

const components = {
  type: { image: Figure, callout: Callout, affiliateBox: AffiliateBox, comparisonTable: ComparisonTable },
  block: { h2: Heading, h3: Heading },
  mark: { link: Link },
};
---
<Base
  title={`${a.seoTitle || a.title} | Jauge`}
  description={a.seoDescription || a.excerpt}
  image={ogImage}
  type="article"
  noindex={a.noindex}
  jsonLd={jsonLd}
  publishedTime={a.publishedAt}
  modifiedTime={modified}
  readingProgress
>
  <main>
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href={`/${cat.slug}`}>{cat.title}</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">{a.title}</span>
        </nav>
        {rubrique && <p class="section-label" style="justify-content:center;">{rubrique}</p>}
        <h1>{a.title}</h1>
        {a.excerpt && <p>{a.excerpt}</p>}
        <div class="article-card-meta" style="justify-content:center;flex-wrap:wrap;">
          {author && <span>Par <a href={`/a-propos#${author.slug}`}>{author.name}</a></span>}
          <span class="sep" aria-hidden="true">·</span>
          <time datetime={a.publishedAt}>Publié le {formatDate(a.publishedAt)}</time>
          {a.updatedAt && (
            <>
              <span class="sep" aria-hidden="true">·</span>
              <time datetime={a.updatedAt}>Mis à jour le {formatDate(a.updatedAt)}</time>
            </>
          )}
          {a.readingTime && (<><span class="sep" aria-hidden="true">·</span><span>{a.readingTime} min de lecture</span></>)}
        </div>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        {hero ? (
          <>
            <img class="article-hero-img" src={hero} alt={a.mainImage?.alt || ''} width="1440" height="630" loading="eager" fetchpriority="high" />
            {a.heroCredit ? <p class="article-hero-credit">{a.heroCredit}</p> : <div class="article-hero-spacer"></div>}
          </>
        ) : null}

        <div class={hasToc ? 'article-layout' : 'article-layout article-layout--no-toc'}>
          <article class="article-body">
            {hasAffiliate && (
              <p class="disclosure">
                Transparence : cet article contient des liens affiliés. Si vous passez par eux, Jauge peut toucher une commission, sans surcoût pour vous et sans influence sur notre avis. <a href="/mentions-legales#affiliation">Notre politique</a>.
              </p>
            )}

            {a.keyTakeaways?.length > 0 && (
              <section class="key-takeaways" aria-labelledby="essentiel">
                <h2 id="essentiel">L'essentiel</h2>
                <ul>{a.keyTakeaways.map((k: string) => <li>{k}</li>)}</ul>
              </section>
            )}

            <PortableText value={body} components={components} onMissingComponent={false} />

            {a.faq?.length > 0 && (
              <section class="article-faq" aria-labelledby="faq">
                <h2 id="faq">Questions fréquentes</h2>
                {a.faq.map((f: any) => (
                  <details>
                    <summary>{f.question}</summary>
                    <p>{f.answer}</p>
                  </details>
                ))}
              </section>
            )}

            {sources.length > 0 && (
              <section class="article-sources" aria-labelledby="sources">
                <h2 id="sources">Sources</h2>
                <ol>
                  {sources.map((x) => (
                    <li><a href={x.url} rel="noopener" target="_blank">{x.title}</a>{x.host && x.title !== x.host && <span class="article-sources-host"> · {x.host}</span>}</li>
                  ))}
                </ol>
              </section>
            )}

            {author && (
              <aside class="author-box" aria-label="À propos de l'auteur·rice">
                {authorPhoto
                  ? <img class="author-box-photo" src={authorPhoto} alt={author.name} width="64" height="64" loading="lazy" />
                  : <span class="author-box-initial" aria-hidden="true">{author.name?.[0]}</span>}
                <div>
                  <p class="author-box-label">Écrit par</p>
                  <p class="author-box-name"><a href={`/a-propos#${author.slug}`} style="color:inherit;text-decoration:none;">{author.name}</a>{author.role && <span style="font-weight:400;color:var(--page-ink-45);"> · {author.role}</span>}</p>
                  {author.bio && <p class="author-box-bio">{author.bio}</p>}
                  {author.linkedin && <p class="author-box-bio" style="margin-top:8px;"><a href={author.linkedin} rel="noopener me" target="_blank">LinkedIn</a></p>}
                </div>
              </aside>
            )}

            <p class="article-back"><a href={`/${cat.slug}`}>← Tous les articles {cat.title}</a></p>
          </article>

          {hasToc && (
            <aside aria-label="Sommaire">
              <nav class="article-toc">
                <p class="article-toc-title">Sommaire</p>
                <ol>{toc.map((t: any) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
              </nav>
            </aside>
          )}
        </div>

        {a.related?.length > 0 && (
          <section class="article-related" aria-labelledby="related-title">
            <h2 id="related-title">À lire aussi</h2>
            <div class="grid-3">{a.related.filter(Boolean).map((r: any) => <ArticleCard article={r} />)}</div>
          </section>
        )}
      </div>
    </section>
  </main>
</Base>
