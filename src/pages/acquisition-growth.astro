---
import Base from '../layouts/Base.astro';
import CategoryArticles from '../components/CategoryArticles.astro';
import { getArticlesByCategory } from '../lib/sanity';

const articles = await getArticlesByCategory('acquisition-growth');
const lastUpdate = articles[0]?.updatedAt || articles[0]?.publishedAt;
const updateLabel = lastUpdate
  ? `Mis à jour le ${new Date(lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })} · ${articles.length} article${articles.length > 1 ? 's' : ''}`
  : 'Premiers articles en préparation';

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": "https://jauge.media/acquisition-growth",
    "name": "Acquisition & Growth — Jauge",
    "description": "SEO, acquisition payante, prospection LinkedIn, tunnel de vente et CRM pour entrepreneurs solo.",
    "url": "https://jauge.media/acquisition-growth",
    "isPartOf": {
      "@id": "https://jauge.media/#website"
    },
    "breadcrumb": {
      "@id": "https://jauge.media/acquisition-growth#breadcrumb"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://jauge.media/acquisition-growth#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://jauge.media/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Catégories",
        "item": "https://jauge.media/categories"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Acquisition & Growth"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": "https://jauge.media/acquisition-growth#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Par où commencer son SEO quand on est seul ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Par la recherche de mots-clés réalistes (pas les plus gros volumes, mais ceux que tu peux vraiment ranker), puis 2-3 articles de fond plutôt que 10 articles superficiels."
        }
      },
      {
        "@type": "Question",
        "name": "Faut-il faire de la publicité payante en solo ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Seulement si tu as un tunnel qui convertit déjà organiquement. La pub amplifie ce qui marche, elle ne répare pas un tunnel cassé."
        }
      },
      {
        "@type": "Question",
        "name": "Quel CRM choisir pour une petite structure ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Le plus simple que tu utiliseras vraiment. Un CRM puissant mais jamais mis à jour vaut moins qu'un tableau simple tenu à jour chaque semaine."
        }
      },
      {
        "@type": "Question",
        "name": "Comment prospecter sur LinkedIn sans avoir l'air d'un bot ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En personnalisant vraiment chaque message à partir du profil de la personne, et en acceptant un taux de réponse plus bas mais plus qualitatif."
        }
      }
    ]
  }
];
if (articles.length) {
  jsonLd.push({
    '@type': 'ItemList',
    '@id': 'https://jauge.media/acquisition-growth#articles',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://jauge.media/acquisition-growth/${a.slug}`,
      name: a.title,
    })),
  } as any);
}
---
<Base
  title="Acquisition & Growth : SEO, prospection, CRM | Jauge"
  description="SEO, acquisition payante, prospection LinkedIn, tunnel de vente, CRM : les vrais chiffres et méthodes qui marchent pour attirer et convertir des clients."
  path="/acquisition-growth"
  jsonLd={jsonLd}
  noindex={articles.length === 0}
>

  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href="/categories">Catégories</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Acquisition &amp; Growth</span>
        </nav>

        <p class="section-label" style="justify-content:center;">Les vrais chiffres</p>
        <h1>Acquisition &amp; Growth</h1>
        <p>SEO, acquisition payante, prospection LinkedIn, tunnel de vente, CRM  les méthodes qui marchent vraiment pour attirer des clients.</p>
        <p style="font-size:.8125rem;color:var(--page-ink-45);margin-top:16px;">{updateLabel}</p>
      </div>
    </section>

    <CategoryArticles category="acquisition-growth" articles={articles} />

    <!-- MAILLAGE INTERNE : LES AUTRES JAUGES -->
    <section class="section section--sm" style="background:var(--dark-bg);" aria-labelledby="autres-jauges-title">
      <div class="container">
        <p class="section-label" style="justify-content:center;">Explorer aussi</p>
        <h2 id="autres-jauges-title" style="text-align:center;margin-bottom:28px;">Les autres jauges</h2>
        <div class="grid-3">
          <a href="/ia-automatisation" class="category-card">
            <div class="category-card-icon" style="background:#3a1810;" aria-hidden="true"><svg class="icon"><use href="#icon-cpu"/></svg></div>
            <h3>Outils &amp; IA</h3>
            <p>Testé, pas hypé.</p>
          </a>
          <a href="/finance-assurances" class="category-card">
            <div class="category-card-icon" style="background:#2a2a28;" aria-hidden="true"><svg class="icon"><use href="#icon-wallet"/></svg></div>
            <h3>Argent &amp; Trésorerie</h3>
            <p>Sans langue de bois.</p>
          </a>
          <a href="/la-jauge" class="category-card category-card--jauge">
            <div class="category-card-icon" style="background:#FFE0D6;" aria-hidden="true"><svg class="icon"><use href="#icon-brain"/></svg></div>
            <h3>La Jauge</h3>
            <p>La tête, pour de vrai.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ SEO -->
    <section class="section section--sm" aria-labelledby="faq-acquisition-title">
      <div class="container" style="max-width:820px;">
        <div style="text-align:center;margin-bottom:28px;">
          <p class="section-label" style="justify-content:center;">Questions fréquentes</p>
          <h2 id="faq-acquisition-title">Acquisition client : les questions qu'on nous pose</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;" class="faq-grid">
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-search"/></svg> Par où commencer son SEO quand on est seul ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Par la recherche de mots-clés réalistes, puis 2-3 articles de fond plutôt que 10 articles superficiels.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-trending-up"/></svg> Faut-il faire de la pub payante en solo ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Seulement si ton tunnel convertit déjà organiquement. La pub amplifie ce qui marche, elle ne répare pas un tunnel cassé.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-settings"/></svg> Quel CRM choisir pour une petite structure ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Le plus simple que tu utiliseras vraiment. Un CRM puissant mais jamais mis à jour vaut moins qu'un tableau simple tenu à jour.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-briefcase"/></svg> Comment prospecter sur LinkedIn sans avoir l'air d'un bot ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">En personnalisant vraiment chaque message à partir du profil de la personne, quitte à accepter un taux de réponse plus bas mais plus qualitatif.</p>
          </article>
        </div>
      </div>
    </section>

  </main>
</Base>
