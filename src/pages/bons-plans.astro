---
import Base from '../layouts/Base.astro';

const jsonLd = [
  {
    "@type": "ItemList",
    "@id": "https://www.jauge-media.com/bons-plans",
    "name": "Bons plans — Jauge",
    "description": "Offres testées sur les outils IA, CRM, comptes pro et automatisation pour entrepreneurs solo.",
    "url": "https://www.jauge-media.com/bons-plans",
    "numberOfItems": 8,
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "n8n",
        "url": "https://n8n.io"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Claude",
        "url": "https://claude.ai"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Qonto",
        "url": "https://qonto.com"
      },
      {
        "@type": "ListItem",
        "position": 4,
        "name": "Brevo",
        "url": "https://brevo.com"
      },
      {
        "@type": "ListItem",
        "position": 5,
        "name": "Notion",
        "url": "https://notion.so"
      },
      {
        "@type": "ListItem",
        "position": 6,
        "name": "Airtable",
        "url": "https://airtable.com"
      },
      {
        "@type": "ListItem",
        "position": 7,
        "name": "Jasper",
        "url": "https://jasper.ai"
      },
      {
        "@type": "ListItem",
        "position": 8,
        "name": "n8n Cloud",
        "url": "https://n8n.io"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": "https://www.jauge-media.com/bons-plans#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Qu'est-ce qu'un bon plan pour entrepreneur ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Une offre réelle sur un outil qu'on utilise ou qu'on a vraiment testé — pas une remise générique copiée d'un comparateur, ni une urgence fabriquée pour faire cliquer. C'est exactement ce qu'on fait sur Jauge, catégorie par catégorie."
        }
      },
      {
        "@type": "Question",
        "name": "Où trouver des codes promo B2B fiables ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Chez Jauge : on centralise les meilleures offres du moment sur les outils IA, CRM, comptes pro et automatisation, testées avant publication — pas un annuaire générique qui agrège des codes expirés."
        }
      },
      {
        "@type": "Question",
        "name": "Comment savoir si une offre n'est pas une fausse promo ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Méfiez-vous des comptes à rebours et des réductions exceptionnelles qui reviennent toutes les semaines. Sur Jauge, chaque offre a des conditions claires et une date de mise à jour visible."
        }
      },
      {
        "@type": "Question",
        "name": "Les offres SaaS gratuites valent-elles vraiment le coup ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Souvent oui pour démarrer, mais il faut vérifier les vraies limites de volume, d'utilisateurs et de support. C'est justement ce qu'on détaille sur chaque fiche Jauge."
        }
      },
      {
        "@type": "Question",
        "name": "Comment Jauge sélectionne ses bons plans ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "On ne recommande que des outils qu'on utilise nous-mêmes ou qu'on a testés sur des tâches réelles. Certains liens sont affiliés, mais ça ne change jamais notre avis."
        }
      },
      {
        "@type": "Question",
        "name": "À quelle fréquence les bons plans sont-ils mis à jour ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Chaque offre est revérifiée sur le site officiel de l'outil, et la date de dernière vérification est indiquée en haut de la page. On retire une offre dès qu'elle expire ou change de conditions."
        }
      }
    ]
  }
];
---
<Base
  title="Bons plans entrepreneur 2026 | Jauge"
  description="Les meilleures offres du moment sur les outils IA, CRM, comptes pro et automatisation, testées avant d'être recommandées, pas un annuaire de plus."
  path="/bons-plans"
  jsonLd={jsonLd}
>

  <main>
    <section class="page-hero page-hero--dark section--sm" aria-labelledby="tools-hero-title">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/" style="color:rgba(255,255,255,.5);">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true" style="color:rgba(255,255,255,.2);">/</span>
          <span style="color:rgba(255,255,255,.7);" aria-current="page">Bons plans</span>
        </nav>

        <p class="section-label" style="color:rgba(255,255,255,.4);justify-content:center;">Testé, par des entrepreneurs</p>
        <h1 id="tools-hero-title" style="color:var(--white);">Les offres qui valent vraiment le coup</h1>
        <p>CRM, IA, comptes pro, automatisation : on ne relaie que ce qu'on a testé. Pas d'urgence fabriquée, pas de faux compte à rebours.</p>

        <div style="margin-top:24px;padding:12px 20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:var(--radius);display:inline-flex;align-items:flex-start;gap:8px;font-size:.8125rem;color:rgba(255,255,255,.5);text-align:left;">
          <svg class="icon" aria-hidden="true" style="flex-shrink:0;"><use href="#icon-tag"/></svg>
          <span>Cette page contient des <a href="/mentions-legales#affiliation" style="color:rgba(255,255,255,.7);text-decoration:underline;">liens affiliés</a> : on touche parfois une commission si vous passez par nos liens, sans surcoût pour vous.<br/><span style="opacity:.75;">Prix et conditions vérifiés sur les sites officiels le 30 octobre 2026.</span></span>
        </div>
      </div>
    </section>

    <!-- ===== 8 ÉPINGLES ===== -->
    <section class="section section--sm" aria-labelledby="pins-title">
      <div class="container">
        <p class="section-label" id="pins-title">Les 8 du moment</p>
        <div class="grid-4" style="gap:16px;margin-top:8px;">

          <a href="/go/n8n" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-star"/></svg> Notre pick</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/N8n-io_idanTsRSNX_1.png" alt="Logo n8n" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">n8n</h3>
            <p class="pin-card-desc">Version Community gratuite en auto-hébergement, sans limite d'exécutions imposée par n8n. Seul coût : votre serveur.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/claude" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Populaire</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Claude_Logo_1.png" alt="Logo Claude" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Claude</h3>
            <p class="pin-card-desc">Accès gratuit à l'assistant IA généraliste, aucune carte bancaire requise pour démarrer.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/qonto" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Compte pro</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Qonto_id47pmDgSE_1.png" alt="Logo Qonto" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Qonto</h3>
            <p class="pin-card-desc">Compte pro en ligne ouvert en quelques minutes. Des offres de bienvenue (mois offerts) circulent régulièrement : vérifiez les conditions avant d'ouvrir.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/brevo" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Email</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Brevo_idgQGSgZ6E_1.png" alt="Logo Brevo" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Brevo</h3>
            <p class="pin-card-desc">Plan gratuit sans limite de durée : 300 emails par jour et jusqu'à 100 000 contacts (logo Brevo dans les emails).</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/notion" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Gestion</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Notion_Logo_2.webp" alt="Logo Notion" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Notion</h3>
            <p class="pin-card-desc">Gratuit pour un utilisateur seul, pages et blocs illimités. Limité à 1 500 blocs dès que vous ajoutez des membres.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/airtable" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Base de données</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Airtable_idtRPEiEoN_1.png" alt="Logo Airtable" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Airtable</h3>
            <p class="pin-card-desc">Version gratuite jusqu'à 1 000 enregistrements par base et 5 éditeurs, sans engagement.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/jasper" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Rédaction IA</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/Jasper_id_Fs809o-_1.png" alt="Logo Jasper" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">Jasper</h3>
            <p class="pin-card-desc">Essai gratuit de 7 jours, puis dès 39 $/mois en paiement annuel (49 $ au mois).</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

          <a href="/go/n8n-cloud" rel="sponsored nofollow noopener" target="_blank" class="pin-card">
            <span class="pin-card-badge"><svg class="icon"><use href="#icon-tag"/></svg> Cloud</span>
            <div class="pin-card-logo" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/N8n-io_idanTsRSNX_1.png" alt="Logo n8n" style="width:100%;height:100%;object-fit:contain;"/></div>
            <h3 class="pin-card-title">n8n Cloud</h3>
            <p class="pin-card-desc">Version hébergée dès 20 €/mois en paiement annuel (2 500 exécutions/mois), sans serveur à gérer.</p>
            <span class="pin-card-cta">J'en profite →</span>
          </a>

        </div>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        <div class="page-with-sidebar">

          <!-- COLONNE PRINCIPALE : FLUX DE BONS PLANS -->
          <div>

            <div class="filter-bar" role="group" aria-label="Filtrer les bons plans">
              <button class="filter-btn active" data-filter="all" data-filter-group="tools" aria-pressed="true">Tous</button>
              <button class="filter-btn" data-filter="automatisation" data-filter-group="tools" aria-pressed="false">Automatisation</button>
              <button class="filter-btn" data-filter="ia" data-filter-group="tools" aria-pressed="false">IA</button>
              <button class="filter-btn" data-filter="gestion" data-filter-group="tools" aria-pressed="false">Gestion &amp; CRM</button>
              <button class="filter-btn" data-filter="email" data-filter-group="tools" aria-pressed="false">Email</button>
            </div>

            <div style="margin-bottom:32px;" data-category="automatisation">
              <div class="tool-card tool-card--highlight" style="max-width:100%;flex-direction:row;align-items:center;flex-wrap:wrap;gap:24px;padding:28px;">
                <div style="display:flex;flex-direction:column;gap:14px;flex:1;min-width:220px;">
                  <div style="display:flex;align-items:center;gap:16px;">
                    <div class="tool-card-logo" style="width:52px;height:52px;background:#fff;border-radius:12px;display:flex;align-items:center;justify-content:center;padding:8px;"><img src="/N8n-io_idanTsRSNX_1.png" alt="Logo n8n" style="width:100%;height:100%;object-fit:contain;"/></div>
                    <div>
                      <div class="affiliate-badge" style="color:rgba(255,255,255,.6);"><svg class="icon"><use href="#icon-star"/></svg> Notre pick · Lien affilié</div>
                      <h3 style="font-size:1.4rem;color:var(--white);">n8n</h3>
                    </div>
                  </div>
                  <p style="font-size:.9375rem;color:rgba(255,255,255,.8);max-width:600px;">
                    C'est celui qui reste après avoir essayé les autres. Gratuit en auto-hébergement (hors coût du serveur), sans abonnement qui explose avec le volume.
                  </p>
                </div>
                <div style="display:flex;flex-direction:column;gap:10px;align-items:center;text-align:center;flex-shrink:0;">
                  <div style="font-size:1.6rem;font-family:var(--font-display);color:var(--white);">Dès 0 €</div>
                  <a href="/go/n8n" rel="sponsored nofollow noopener" target="_blank" class="btn btn-primary" aria-label="Essayer n8n - lien affilié">Voir l'offre →</a>
                </div>
              </div>
            </div>

            <div class="article-list" style="display:flex;flex-direction:column;gap:14px;">

              <a href="/go/claude" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="ia">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Claude_Logo_1.png" alt="Logo Claude" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-ia">IA</span><span class="sep">·</span><span>Gratuit pour démarrer</span></div>
                  <h3>Claude</h3>
                  <p>Solide pour rédiger, analyser et structurer. Pas magique, mais tient le mieux sur des tâches longues.</p>
                  <div class="article-list-footer"><span class="read-time">0 €/mois pour commencer</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/qonto" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="gestion">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Qonto_id47pmDgSE_1.png" alt="Logo Qonto" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-finance">Compte pro</span><span class="sep">·</span><span>Voir les formules</span></div>
                  <h3>Qonto</h3>
                  <p>Le compte pro qui reste le plus lisible sur les frais réels, cartes et virements inclus dans les formules.</p>
                  <div class="article-list-footer"><span class="read-time">Voir les formules</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/notion" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="gestion">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Notion_Logo_2.webp" alt="Logo Notion" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-outils">Gestion</span><span class="sep">·</span><span>Gratuit</span></div>
                  <h3>Notion</h3>
                  <p>Devient un CRM correct si vous prenez 30 minutes pour le structurer. Sinon, ça reste un cimetière de notes.</p>
                  <div class="article-list-footer"><span class="read-time">0 €/mois</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/jasper" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="ia">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Jasper_id_Fs809o-_1.png" alt="Logo Jasper" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-ia">Rédaction IA</span><span class="sep">·</span><span>Dès 39 $/mois (annuel)</span></div>
                  <h3>Jasper</h3>
                  <p>Correct pour du contenu marketing en volume — le tarif ne se justifie que si vous produisez vraiment beaucoup.</p>
                  <div class="article-list-footer"><span class="read-time">Dès 39 $/mois (annuel)</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/airtable" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="gestion">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Airtable_idtRPEiEoN_1.png" alt="Logo Airtable" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-outils">Base de données</span><span class="sep">·</span><span>Gratuit</span></div>
                  <h3>Airtable</h3>
                  <p>Le bon choix quand un tableur ne suffit plus mais qu'un vrai CRM serait surdimensionné.</p>
                  <div class="article-list-footer"><span class="read-time">0 €/mois</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/brevo" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="email">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/Brevo_idgQGSgZ6E_1.png" alt="Logo Brevo" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-business">Email marketing</span><span class="sep">·</span><span>Gratuit</span></div>
                  <h3>Brevo</h3>
                  <p>Le rapport fonctionnalités/prix le plus honnête du marché pour une newsletter qui grossit.</p>
                  <div class="article-list-footer"><span class="read-time">0 €/mois</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

              <a href="/go/n8n-cloud" rel="sponsored nofollow noopener" target="_blank" class="article-list-item" data-category="automatisation">
                <div class="article-list-img" style="background:#fff;display:flex;align-items:center;justify-content:center;padding:24px;"><img src="/N8n-io_idanTsRSNX_1.png" alt="Logo n8n" width="220" height="220" loading="lazy" style="width:100%;height:100%;object-fit:contain;" /></div>
                <div class="article-list-body">
                  <div class="article-card-meta"><span class="tag tag-n8n">Automatisation</span><span class="sep">·</span><span>Dès 20 €/mois (annuel)</span></div>
                  <h3>n8n Cloud</h3>
                  <p>La version hébergée, pour la puissance de n8n sans gérer de serveur.</p>
                  <div class="article-list-footer"><span class="read-time">Dès 20 €/mois (annuel)</span><span class="read-more">Voir l'offre →</span></div>
                </div>
              </a>

            </div>

          </div>

          <!-- SIDEBAR : MÉTHODE + NEWSLETTER + PROPOSER UN OUTIL -->
          <aside class="sidebar" aria-label="Notre méthode et newsletter">

            <div class="sidebar-widget sidebar-widget-sticky">
              <h4>Comment on choisit nos bons plans</h4>
              <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;">
                <li style="display:flex;gap:10px;align-items:flex-start;font-size:.875rem;color:var(--ink-70);line-height:1.5;"><svg class="icon" style="color:var(--accent-dark);flex-shrink:0;margin-top:2px;" aria-hidden="true"><use href="#icon-flask"/></svg><span><strong>Testé par nous.</strong> Uniquement des outils qu'on utilise ou qu'on a essayés sur des tâches réelles.</span></li>
                <li style="display:flex;gap:10px;align-items:flex-start;font-size:.875rem;color:var(--ink-70);line-height:1.5;"><svg class="icon" style="color:var(--accent-dark);flex-shrink:0;margin-top:2px;" aria-hidden="true"><use href="#icon-check-circle"/></svg><span><strong>Prix vérifiés</strong> sur les sites officiels, avec la date de vérification en haut de page.</span></li>
                <li style="display:flex;gap:10px;align-items:flex-start;font-size:.875rem;color:var(--ink-70);line-height:1.5;"><svg class="icon" style="color:var(--accent-dark);flex-shrink:0;margin-top:2px;" aria-hidden="true"><use href="#icon-tag"/></svg><span><strong>Liens affiliés signalés.</strong> Une commission ne change jamais notre avis.</span></li>
                <li style="display:flex;gap:10px;align-items:flex-start;font-size:.875rem;color:var(--ink-70);line-height:1.5;"><svg class="icon" style="color:var(--accent-dark);flex-shrink:0;margin-top:2px;" aria-hidden="true"><use href="#icon-ban"/></svg><span><strong>Pas de fausse urgence.</strong> Ni compte à rebours, ni promo « exceptionnelle » permanente.</span></li>
              </ul>

              <div style="margin-top:28px;">
                <h4>Rejoignez la newsletter</h4>
                <p style="font-size:.875rem;color:var(--ink-70);margin-bottom:14px;">Un outil testé, chaque semaine.</p>
                <form data-newsletter action="/api/newsletter" method="post" aria-label="Inscription newsletter" style="display:flex;flex-direction:column;gap:8px;">
                  <input type="email" name="email" class="form-input" placeholder="vous@email.com" required autocomplete="email" aria-label="Votre adresse email" />
                  <button type="submit" class="btn btn-primary" style="justify-content:center;">S'inscrire →</button>
                </form>
              </div>

              <div style="margin-top:28px;">
