---
import Base from '../layouts/Base.astro';

const jsonLd = [
  {
    "@type": "ContactPage",
    "@id": "https://jauge.media/contact/#contactpage",
    "url": "https://jauge.media/contact",
    "name": "Contact | Jauge",
    "isPartOf": {
      "@id": "https://jauge.media/#website"
    },
    "about": {
      "@id": "https://jauge.media/#organization"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://jauge.media/contact/#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://jauge.media/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Contact",
        "item": "https://jauge.media/contact"
      }
    ]
  }
];
---
<Base
  title="Contact | Jauge"
  description="Une question, une suggestion d'article, un retour d'expérience ? Écris à Tiphaine et Marie, on lit tous les messages."
  path="/contact"
  jsonLd={jsonLd}
>


  <main>
    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Contact</span>
        </nav>
        <p class="section-label" style="justify-content:center;">Nous écrire</p>
        <h1>Nous contacter</h1>
        <p>Une question, une suggestion d'article, un retour d'expérience ou une proposition de partenariat ? Tiphaine et Marie lisent tous les messages et répondent sous 48h pas de standard, pas de bot.</p>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        <div class="page-with-sidebar">

          <!-- FORMULAIRE -->
          <div>
            <form class="contact-form" action="/api/contact" method="post" aria-label="Formulaire de contact">
              <div class="form-row">
                <div class="form-group">
                  <label for="contact-prenom">Prénom</label>
                  <input type="text" id="contact-prenom" name="prenom" class="form-input" placeholder="Thomas" required autocomplete="given-name" />
                </div>
                <div class="form-group">
                  <label for="contact-email">Email</label>
                  <input type="email" id="contact-email" name="email" class="form-input" placeholder="vous@email.com" required autocomplete="email" />
                </div>
              </div>
              <div class="form-group">
                <label for="contact-sujet">Sujet</label>
                <select id="contact-sujet" name="sujet" class="form-input">
                  <option value="">Choisis un sujet</option>
                  <option value="question-article">Question sur un article</option>
                  <option value="suggestion-contenu">Suggestion de contenu</option>
                  <option value="partenariat">Proposition de partenariat</option>
                  <option value="erreur-correction">Erreur ou correction</option>
                  <option value="autre">Autre</option>
                </select>
              </div>
              <div class="form-group">
                <label for="contact-message">Message</label>
                <textarea id="contact-message" name="message" class="form-input" placeholder="Ton message..." required aria-required="true"></textarea>
              </div>
              <div style="display:flex;align-items:center;gap:8px;">
                <input type="checkbox" id="rgpd-consent" name="rgpd" required aria-required="true" style="width:16px;height:16px;flex-shrink:0;" />
                <label for="rgpd-consent" style="font-size:.875rem;color:var(--page-ink-70);">
                  J'accepte que mes données soient utilisées pour traiter ma demande, conformément à la <a href="/mentions-legales#rgpd" style="color:var(--accent);">politique RGPD</a>.
                </label>
              </div>
              <button type="submit" class="btn btn-primary" style="align-self:flex-start;">Envoyer le message →</button>
            </form>
          </div>

          <!-- SIDEBAR -->
          <aside class="sidebar" aria-label="Contact direct">
            <div class="sidebar-widget sidebar-widget-sticky">

              <div style="display:flex;align-items:center;gap:-8px;margin-bottom:16px;">
                <img src="/tiphaine.jpeg" alt="Tiphaine, cofondatrice de Jauge" width="44" height="44" loading="lazy" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 0 0 1px var(--ink-15);" />
                <img src="https://placehold.co/200x200/f4f2ee/8a877d?text=Marie&font=roboto" alt="Marie, cofondatrice de Jauge" width="44" height="44" loading="lazy" style="width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid #fff;box-shadow:0 0 0 1px var(--ink-15);margin-left:-14px;" />
              </div>

              <h4 style="margin-bottom:8px;">Tu écris directement à Tiphaine et Marie</h4>
              <p style="font-size:.875rem;color:var(--ink-70);margin-bottom:16px;">Pas d'équipe support, pas de ticket qui traîne. On lit et on répond nous-mêmes.</p>

              <div style="display:flex;align-items:center;gap:8px;background:#f7f5f3;border-radius:12px;padding:12px 14px;margin-bottom:20px;">
                <svg class="icon" style="color:var(--accent-dark);flex-shrink:0;"><use href="#icon-clock"/></svg>
                <span style="font-size:.875rem;color:var(--ink-70);">Réponse sous 48h en général</span>
              </div>

              <hr style="border:none;border-top:1px solid var(--ink-15);margin:20px 0;" />

              <p style="font-size:.875rem;color:var(--ink-70);margin-bottom:8px;">Tu préfères l'email direct ?</p>
              <a href="mailto:contact@jauge.media" class="btn btn-outline btn-sm" style="width:100%;justify-content:center;">contact@jauge.media</a>

              <hr style="border:none;border-top:1px solid var(--ink-15);margin:20px 0;" />

              <p style="font-size:.9375rem;color:var(--ink-70);margin-bottom:12px;">Envie d'en savoir plus sur nous ?</p>
              <a href="/a-propos" class="btn btn-primary btn-sm" style="width:100%;justify-content:center;">Voir la page à propos →</a>
            </div>
          </aside>

        </div>
      </div>
    </section>
  </main>
</Base>
