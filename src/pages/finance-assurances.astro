---
import Base from '../layouts/Base.astro';
import CategoryArticles from '../components/CategoryArticles.astro';
import { getArticlesByCategory } from '../lib/sanity';

const articles = await getArticlesByCategory('finance-assurances');
const lastUpdate = articles[0]?.updatedAt || articles[0]?.publishedAt;
const updateLabel = lastUpdate
  ? `Mis à jour le ${new Date(lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })} · ${articles.length} article${articles.length > 1 ? 's' : ''}`
  : 'Premiers articles en préparation';

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": "https://www.jauge-media.com/finance-assurances",
    "name": "Argent & Trésorerie — Jauge",
    "description": "Compte pro, comptabilité, fiscalité, assurances et trésorerie pour entrepreneurs solo.",
    "url": "https://www.jauge-media.com/finance-assurances",
    "isPartOf": {
      "@id": "https://www.jauge-media.com/#website"
    },
    "breadcrumb": {
      "@id": "https://www.jauge-media.com/finance-assurances#breadcrumb"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://www.jauge-media.com/finance-assurances#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://www.jauge-media.com/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Catégories",
        "item": "https://www.jauge-media.com/categories"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Argent & Trésorerie"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": "https://www.jauge-media.com/finance-assurances#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Comment choisir son compte pro ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Sur l'usage réel : volume de transactions, besoin de cartes, intégration facturation."
        }
      },
      {
        "@type": "Question",
        "name": "Quelle assurance professionnelle est vraiment indispensable ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "La RC Pro, dans la quasi-totalité des activités de service. Le reste (prévoyance, mutuelle) dépend de votre situation personnelle et de votre statut."
        }
      },
      {
        "@type": "Question",
        "name": "Faut-il un comptable ou un logiciel suffit-il ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Un logiciel suffit pour la tenue courante en micro-entreprise. Dès que la structure se complexifie (société, TVA, salariés), un comptable devient rentable, pas un luxe."
        }
      },
      {
        "@type": "Question",
        "name": "Comment gérer un mois creux de trésorerie ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "En distinguant vite si c'est un creux ponctuel ou un vrai signal d'alerte, grâce à un prévisionnel simple mis à jour chaque semaine plutôt qu'une fois par trimestre."
        }
      }
    ]
  }
];
if (articles.length) {
  jsonLd.push({
    '@type': 'ItemList',
    '@id': 'https://www.jauge-media.com/finance-assurances#articles',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://www.jauge-media.com/finance-assurances/${a.slug}`,
      name: a.title,
    })),
  } as any);
}
---
<Base
  title="Argent & Trésorerie : compte pro, fiscalité, assurances | Jauge"
  description="Compte pro, comptabilité, fiscalité, assurances, trésorerie : ce qu'il faut suivre pour ne pas se faire surprendre."
  path="/finance-assurances"
  jsonLd={jsonLd}
  noindex={articles.length === 0}
>

  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href="/categories">Catégories</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Argent &amp; Trésorerie</span>
        </nav>

        <p class="section-label" style="justify-content:center;">Sans langue de bois</p>
        <h1>Argent &amp; Trésorerie</h1>
        <p>Compte pro, comptabilité, fiscalité, assurances, trésorerie : ce qu'il faut suivre pour ne pas se faire surprendre.</p>
        <p style="font-size:.8125rem;color:var(--page-ink-45);margin-top:16px;">{updateLabel}</p>
      </div>
    </section>

    <CategoryArticles category="finance-assurances" articles={articles} />

    <!-- MAILLAGE INTERNE : LES AUTRES JAUGES -->
    <section class="section section--sm" style="background:var(--dark-bg);" aria-labelledby="autres-jauges-title">
      <div class="container">
        <p class="section-label" style="justify-content:center;">Explorer aussi</p>
        <h2 id="autres-jauges-title" style="text-align:center;margin-bottom:28px;">Les autres jauges</h2>
        <div class="grid-3">
          <a href="/ia-automatisation" class="category-card">
            <div class="category-card-icon" style="background:#3a1810;" aria-hidden="true"><svg class="icon"><use href="#icon-cpu"/></svg></div>
            <h3>Outils &amp; IA</h3>
            <p>IA, no-code, automatisation.</p>
          </a>
          <a href="/acquisition-growth" class="category-card">
            <div class="category-card-icon" style="background:#2e3a1a;" aria-hidden="true"><svg class="icon"><use href="#icon-target"/></svg></div>
            <h3>Acquisition &amp; Growth</h3>
            <p>SEO, prospection, CRM.</p>
          </a>
          <a href="/la-jauge" class="category-card category-card--jauge">
            <div class="category-card-icon" style="background:#FFE0D6;" aria-hidden="true"><svg class="icon"><use href="#icon-brain"/></svg></div>
            <h3>La Jauge</h3>
            <p>Charge mentale, solitude, burnout.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ SEO -->
    <section class="section section--sm" aria-labelledby="faq-finance-title">
      <div class="container" style="max-width:820px;">
        <div style="text-align:center;margin-bottom:28px;">
          <p class="section-label" style="justify-content:center;">Questions fréquentes</p>
          <h2 id="faq-finance-title">Argent d'entrepreneur : les questions qu'on nous pose</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;" class="faq-grid">
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-bank"/></svg> Comment choisir son compte pro ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Sur l'usage réel : volume de transactions, besoin de cartes, intégration facturation.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-shield"/></svg> Quelle assurance est vraiment indispensable ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">La RC Pro, dans la quasi-totalité des activités de service. Le reste dépend de votre situation personnelle et de votre statut.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-bar-chart"/></svg> Faut-il un comptable ou un logiciel suffit-il ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Un logiciel suffit en micro-entreprise. Dès que la structure se complexifie, un comptable devient rentable, pas un luxe.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-credit-card"/></svg> Comment gérer un mois creux de trésorerie ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">En distinguant vite si c'est un creux ponctuel ou un vrai signal, grâce à un prévisionnel simple mis à jour chaque semaine.</p>
          </article>
        </div>
      </div>
    </section>

  </main>
</Base>
