---
import Base from '../layouts/Base.astro';

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": "https://jauge.media/guides",
    "name": "Guides & livres blancs — Jauge",
    "description": "Guides PDF téléchargeables sur les outils IA, l'acquisition, l'argent et la charge mentale d'entrepreneur.",
    "url": "https://jauge.media/guides",
    "isPartOf": {
      "@id": "https://jauge.media/#website"
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://jauge.media/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Guides",
        "item": "https://jauge.media/guides"
      }
    ]
  }
];
---
<Base
  title="Guides & livres blancs à télécharger | Jauge"
  description="Des guides PDF complets sur les outils IA, l'acquisition, l'argent et la charge mentale d'entrepreneur — à télécharger gratuitement."
  path="/guides"
  jsonLd={jsonLd}
>

  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Guides</span>
        </nav>

        <p class="section-label" style="justify-content:center;">Bibliothèque à télécharger</p>
        <h1>Guides &amp; livres blancs</h1>
        <p>Des PDF complets à garder sous la main; Gratuits, sans carte bancaire, un email suffit.</p>
      </div>
    </section>

    <section class="section section--sm">
      <div class="container">
        <div class="page-with-sidebar">

          <!-- LISTING DES GUIDES -->
          <div>
            <div class="article-list" style="display:flex;flex-direction:column;gap:16px;">

              <a href="/newsletter" class="article-list-item">
                <div class="article-list-img">
                  <img src="https://images.pexels.com/photos/8386440/pexels-photo-8386440.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Outils IA affichés sur un écran d'ordinateur" width="220" height="220" loading="lazy" />
                </div>
                <div class="article-list-body">
                  <div class="article-card-meta">
                    <span class="tag tag-ia">Outils &amp; IA</span>
                    <span class="sep" aria-hidden="true">·</span>
                    <span>PDF · 18 pages</span>
                  </div>
                  <h3>Le guide des outils IA vraiment utiles pour un solo</h3>
                  <p>Pas 40 outils, les 6 qui comptent vraiment avec ce qui vaut le coup de payer et ce qui reste gratuit toute l'année.</p>
                  <div class="article-list-footer">
                    <span class="read-time"><svg class="icon"><use href="#icon-file-text"/></svg> 18 pages</span>
                    <span class="read-more">Télécharger →</span>
                  </div>
                </div>
              </a>

              <a href="/newsletter" class="article-list-item">
                <div class="article-list-img">
                  <img src="https://images.pexels.com/photos/265087/pexels-photo-265087.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Entrepreneur travaillant sa stratégie d'acquisition client" width="220" height="220" loading="lazy" />
                </div>
                <div class="article-list-body">
                  <div class="article-card-meta">
                    <span class="tag tag-acquisition">Acquisition &amp; Growth</span>
                    <span class="sep" aria-hidden="true">·</span>
                    <span>PDF · 14 pages</span>
                  </div>
                  <h3>La checklist acquisition client pour freelance</h3>
                  <p>Les leviers qui marchent vraiment quand on est seul, dans l'ordre où les activer.</p>
                  <div class="article-list-footer">
                    <span class="read-time"><svg class="icon"><use href="#icon-file-text"/></svg> 14 pages</span>
                    <span class="read-more">Télécharger →</span>
                  </div>
                </div>
              </a>

              <a href="/newsletter" class="article-list-item">
                <div class="article-list-img">
                  <img src="https://images.pexels.com/photos/6863183/pexels-photo-6863183.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Entrepreneur comparant des comptes professionnels" width="220" height="220" loading="lazy" />
                </div>
                <div class="article-list-body">
                  <div class="article-card-meta">
                    <span class="tag tag-finance">Argent &amp; Trésorerie</span>
                    <span class="sep" aria-hidden="true">·</span>
                    <span>PDF · 22 pages</span>
                  </div>
                  <h3>Le guide complet du compte pro et de la trésorerie solo</h3>
                  <p>Comment choisir son compte pro, lire ses vrais frais, et ne plus paniquer devant un mois creux.</p>
                  <div class="article-list-footer">
                    <span class="read-time"><svg class="icon"><use href="#icon-file-text"/></svg> 22 pages</span>
                    <span class="read-more">Télécharger →</span>
                  </div>
                </div>
              </a>

              <a href="/newsletter" class="article-list-item">
                <div class="article-list-img">
                  <img src="https://images.pexels.com/photos/3760810/pexels-photo-3760810.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Entrepreneur solo submergé par la charge mentale" width="220" height="220" loading="lazy" />
                </div>
                <div class="article-list-body">
                  <div class="article-card-meta">
                    <span class="tag tag-jauge">La Jauge</span>
                    <span class="sep" aria-hidden="true">·</span>
                    <span>PDF · 20 pages</span>
                  </div>
                  <h3>Le guide de la charge mentale d'entrepreneur</h3>
                  <p>Reconnaître les signaux, nommer ce qui pèse, et des pistes concrètes pas des respirations profondes.</p>
                  <div class="article-list-footer">
                    <span class="read-time"><svg class="icon"><use href="#icon-file-text"/></svg> 20 pages</span>
                    <span class="read-more">Télécharger →</span>
                  </div>
                </div>
              </a>

            </div>
          </div>

          <!-- SIDEBAR -->
          <aside class="sidebar" aria-label="Liens utiles">

            <div class="sidebar-widget sidebar-widget-sticky">
              <h4>Rejoins la newsletter</h4>
              <p style="font-size:.9375rem;color:var(--ink-70);margin-bottom:16px;">Un outil testé, un chiffre qui compte, un truc sur la tête. Chaque semaine, sans spam.</p>
              <form data-newsletter action="/api/newsletter" method="post" aria-label="Inscription newsletter" style="display:flex;flex-direction:column;gap:8px;">
                <input type="email" name="email" class="form-input" placeholder="ton@email.com" required autocomplete="email" aria-label="Ton adresse email" />
                <button type="submit" class="btn btn-primary" style="justify-content:center;">S'inscrire →</button>
              </form>
            </div>

            <div class="sidebar-widget">
              <h4>Explorer les jauges</h4>
              <div class="sidebar-list">
                <div class="sidebar-list-item"><a href="/ia-automatisation" style="display:flex;align-items:center;gap:6px;"><svg class="icon"><use href="#icon-cpu"/></svg> Outils &amp; IA</a></div>
                <div class="sidebar-list-item"><a href="/acquisition-growth" style="display:flex;align-items:center;gap:6px;"><svg class="icon"><use href="#icon-target"/></svg> Acquisition &amp; Growth</a></div>
                <div class="sidebar-list-item"><a href="/finance-assurances" style="display:flex;align-items:center;gap:6px;"><svg class="icon"><use href="#icon-wallet"/></svg> Argent &amp; Trésorerie</a></div>
                <div class="sidebar-list-item"><a href="/la-jauge" style="display:flex;align-items:center;gap:6px;"><svg class="icon"><use href="#icon-brain"/></svg> La Jauge</a></div>
              </div>
            </div>

            <div class="sidebar-widget">
              <h4>Pourquoi c'est gratuit ?</h4>
              <p style="font-size:.875rem;color:var(--ink-70);margin:0;">Ces guides sont financés par l'affiliation sur nos recommandations d'outils, pas par la vente de tes données. Ton email sert uniquement à t'envoyer le PDF et la newsletter.</p>
            </div>

          </aside>

        </div>
      </div>
    </section>

  </main>
</Base>
