---
import Base from '../layouts/Base.astro';
import CategoryArticles from '../components/CategoryArticles.astro';
import { getArticlesByCategory } from '../lib/sanity';

const articles = await getArticlesByCategory('ia-automatisation');
const lastUpdate = articles[0]?.updatedAt || articles[0]?.publishedAt;
const updateLabel = lastUpdate
  ? `Mis à jour le ${new Date(lastUpdate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })} · ${articles.length} article${articles.length > 1 ? 's' : ''}`
  : 'Premiers articles en préparation';

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": "https://jauge.media/ia-automatisation",
    "name": "Outils & IA — Jauge",
    "description": "Outils IA, workflows no-code et automatisation administrative pour entrepreneurs solo.",
    "url": "https://jauge.media/ia-automatisation",
    "isPartOf": {
      "@id": "https://jauge.media/#website"
    },
    "breadcrumb": {
      "@id": "https://jauge.media/ia-automatisation#breadcrumb"
    }
  },
  {
    "@type": "BreadcrumbList",
    "@id": "https://jauge.media/ia-automatisation#breadcrumb",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Accueil",
        "item": "https://jauge.media/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Catégories",
        "item": "https://jauge.media/categories"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "Outils & IA"
      }
    ]
  },
  {
    "@type": "FAQPage",
    "@id": "https://jauge.media/ia-automatisation#faq",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Quels outils IA sont vraiment utiles à un solo ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Peu, en fait. Un assistant généraliste, un outil d'automatisation no-code comme n8n ou Make, et une gestion simple suffisent souvent. Le reste est du bruit marketing."
        }
      },
      {
        "@type": "Question",
        "name": "Faut-il coder pour automatiser son business ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Non. Les outils no-code comme n8n, Make ou Zapier permettent de connecter tes applications sans écrire une ligne de code."
        }
      },
      {
        "@type": "Question",
        "name": "Quel est le meilleur assistant IA pour un entrepreneur ?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Ça dépend de l'usage : Claude tient mieux sur les tâches longues et l'analyse, ChatGPT a le plus d'intégrations tierces. Le vrai critère, c'est celui que tu utiliseras vraiment au quotidien."
        }
      }
    ]
  }
];
if (articles.length) {
  jsonLd.push({
    '@type': 'ItemList',
    '@id': 'https://jauge.media/ia-automatisation#articles',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `https://jauge.media/ia-automatisation/${a.slug}`,
      name: a.title,
    })),
  } as any);
}
---
<Base
  title="Outils & IA : testé par nous les humains | Jauge"
  description="Outils IA, workflows no-code, automatisation administrative : ce qu'on a vraiment testé, avec un avis tranché plutôt qu'un top 10 générique."
  path="/ia-automatisation"
  jsonLd={jsonLd}
  noindex={articles.length === 0}
>

  <main>

    <section class="page-hero">
      <div class="container">
        <nav class="breadcrumb" aria-label="Fil d'Ariane" style="justify-content:center;">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <a href="/categories">Catégories</a>
          <span class="breadcrumb-sep" aria-hidden="true">/</span>
          <span aria-current="page">Outils &amp; IA</span>
        </nav>

        <p class="section-label" style="justify-content:center;">Testé, par nous les solopreneurs</p>
        <h1>Outils &amp; IA</h1>
        <p>Outils IA, workflows no-code, automatisation administrative ce qu'on a vraiment testé sur des tâches réelles, avec un avis tranché plutôt qu'un top 10 écrit par un algorithme.</p>
        <p style="font-size:.8125rem;color:var(--page-ink-45);margin-top:16px;">{updateLabel}</p>
      </div>
    </section>

    <CategoryArticles category="ia-automatisation" articles={articles} />

    <!-- MAILLAGE INTERNE : LES AUTRES JAUGES -->
    <section class="section section--sm" style="background:var(--dark-bg);" aria-labelledby="autres-jauges-title">
      <div class="container">
        <p class="section-label" style="justify-content:center;">Explorer aussi</p>
        <h2 id="autres-jauges-title" style="text-align:center;margin-bottom:28px;">Les autres jauges</h2>
        <div class="grid-3">
          <a href="/acquisition-growth" class="category-card">
            <div class="category-card-icon" style="background:#2e3a1a;" aria-hidden="true"><svg class="icon"><use href="#icon-target"/></svg></div>
            <h3>Acquisition &amp; Growth</h3>
            <p>Les vrais chiffres.</p>
          </a>
          <a href="/finance-assurances" class="category-card">
            <div class="category-card-icon" style="background:#2a2a28;" aria-hidden="true"><svg class="icon"><use href="#icon-wallet"/></svg></div>
            <h3>Argent &amp; Trésorerie</h3>
            <p>Sans langue de bois.</p>
          </a>
          <a href="/la-jauge" class="category-card category-card--jauge">
            <div class="category-card-icon" style="background:#FFE0D6;" aria-hidden="true"><svg class="icon"><use href="#icon-brain"/></svg></div>
            <h3>La Jauge</h3>
            <p>La tête, pour de vrai.</p>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ SEO -->
    <section class="section section--sm" aria-labelledby="faq-ia-title">
      <div class="container" style="max-width:820px;">
        <div style="text-align:center;margin-bottom:28px;">
          <p class="section-label" style="justify-content:center;">Questions fréquentes</p>
          <h2 id="faq-ia-title">Outils IA : les questions qu'on nous pose</h2>
        </div>
        <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;" class="faq-grid">
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-cpu"/></svg> Quels outils IA sont vraiment utiles à un solo ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Peu, en fait. Un assistant généraliste, un outil d'automatisation no-code et une gestion simple suffisent souvent. Le reste est du bruit marketing.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-settings"/></svg> Faut-il coder pour automatiser son business ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Non. Les outils no-code comme n8n, Make ou Zapier permettent de connecter tes applications sans écrire une ligne de code.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-cpu"/></svg> Quel est le meilleur assistant IA pour un entrepreneur ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Ça dépend de l'usage : Claude tient mieux sur les tâches longues, ChatGPT a plus d'intégrations. Le vrai critère, c'est celui que tu utiliseras vraiment.</p>
          </article>
          <article class="faq-item" style="background:#fff;border:1px solid var(--ink-15);border-radius:20px;padding:22px;">
            <h3 style="font-size:1.05rem;margin-bottom:10px;display:flex;align-items:center;gap:8px;"><svg class="icon" style="color:var(--accent);flex-shrink:0;"><use href="#icon-rocket"/></svg> Par où commencer pour automatiser son activité ?</h3>
            <p style="margin:0;color:var(--ink-70);line-height:1.7;">Par la tâche répétitive qui te pèse le plus, pas par la plus impressionnante à automatiser. Une victoire rapide vaut mieux qu'un chantier ambitieux abandonné.</p>
          </article>
        </div>
      </div>
    </section>

  </main>
</Base>
